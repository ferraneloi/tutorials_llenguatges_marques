---

<div class="lang-switcher" id="lang-switcher-container">
	<button id="lang-toggle-btn" class="lang-btn" type="button" aria-label="Canvia d'idioma Català / Castellà" title="Canvia d'idioma (CA / ES)">
		<span class="lang-opt" data-lang="ca">CA</span>
		<span class="lang-divider">/</span>
		<span class="lang-opt" data-lang="es">ES</span>
	</button>
</div>

<script>
	import { translations } from '../i18n/translations';

	function applyTranslations(lang: 'ca' | 'es') {
		const dict = translations[lang] || translations.ca;
		document.documentElement.lang = lang;
		
		// Update all text elements
		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const key = el.getAttribute('data-i18n') as keyof typeof dict;
			if (key && dict[key]) {
				el.textContent = dict[key];
			}
		});

		// Update all html elements
		document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
			const key = el.getAttribute('data-i18n-html') as keyof typeof dict;
			if (key && dict[key]) {
				el.innerHTML = dict[key];
			}
		});

		// Update active UI state on toggle button
		document.querySelectorAll('.lang-opt').forEach((opt) => {
			if (opt.getAttribute('data-lang') === lang) {
				opt.classList.add('active');
			} else {
				opt.classList.remove('active');
			}
		});
	}

	function setupLangToggle() {
		const savedLang = (localStorage.getItem('lang') as 'ca' | 'es') || 'ca';
		applyTranslations(savedLang);

		const toggleBtn = document.getElementById('lang-toggle-btn');
		if (!toggleBtn) return;

		toggleBtn.onclick = () => {
			const currentLang = (localStorage.getItem('lang') as 'ca' | 'es') || 'ca';
			const nextLang: 'ca' | 'es' = currentLang === 'ca' ? 'es' : 'ca';
			localStorage.setItem('lang', nextLang);
			applyTranslations(nextLang);
		};
	}

	// Initial execution
	setupLangToggle();

	// Support Astro view transitions / swaps
	document.addEventListener('astro:page-load', setupLangToggle);
	document.addEventListener('astro:after-swap', setupLangToggle);
</script>

<style>
	.lang-switcher {
		display: flex;
		align-items: center;
	}

	.lang-btn {
		height: 38px;
		padding: 0 0.75rem;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid var(--border-card);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		cursor: pointer;
		font-family: 'Outfit', sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		transition: all 0.25s ease;
	}

	.lang-btn:hover {
		background: rgba(99, 102, 241, 0.15);
		border-color: rgba(99, 102, 241, 0.35);
		color: var(--text-title);
		transform: translateY(-2px);
	}

	.lang-divider {
		opacity: 0.4;
		font-weight: 400;
	}

	.lang-opt {
		transition: color 0.2s ease;
	}

	.lang-opt.active {
		color: #818cf8;
		font-weight: 800;
	}

	:global(html.light-theme) .lang-opt.active {
		color: #4f46e5;
	}
</style>
