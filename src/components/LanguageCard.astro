---
interface Props {
	title: string;
	badge: string;
	badgeKey: string;
	url: string;
	color: 'xml' | 'md' | 'svg' | 'mathml';
	description: string;
	descKey: string;
	buttonLabel: string;
	btnKey: string;
}

const {
	title,
	badge,
	badgeKey,
	url,
	color,
	description,
	descKey,
	buttonLabel,
	btnKey
} = Astro.props;

const colorClasses = {
	xml: {
		border: 'card-xml',
		badge: 'badge-xml',
		btn: 'btn-xml',
		iconBg: 'linear-gradient(135deg, #f97316, #ea580c)'
	},
	md: {
		border: 'card-md',
		badge: 'badge-md',
		btn: 'btn-md',
		iconBg: 'linear-gradient(135deg, #0284c7, #0369a1)'
	},
	svg: {
		border: 'card-svg',
		badge: 'badge-svg',
		btn: 'btn-svg',
		iconBg: 'linear-gradient(135deg, #ec4899, #be185d)'
	},
	mathml: {
		border: 'card-mathml',
		badge: 'badge-mathml',
		btn: 'btn-mathml',
		iconBg: 'linear-gradient(135deg, #8b5cf6, #6d28d9)'
	}
}[color];
---

<div class={`dash-card ${colorClasses.border}`}>
	<div class="card-top">
		<div class="icon-wrapper" style={`background: ${colorClasses.iconBg}`}>
			{color === 'xml' && (
				<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="16 18 22 12 16 6"></polyline>
					<polyline points="8 6 2 12 8 18"></polyline>
					<line x1="14" y1="4" x2="10" y2="20"></line>
				</svg>
			)}
			{color === 'md' && (
				<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="4" width="20" height="16" rx="3"></rect>
					<path d="M6 15V9l3 3.5L12 9v6"></path>
					<path d="M18 12l-2.5 3-2.5-3"></path>
					<line x1="15.5" y1="9" x2="15.5" y2="14.5"></line>
				</svg>
			)}
			{color === 'svg' && (
				<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
					<polyline points="2 17 12 22 22 17"></polyline>
					<polyline points="2 12 12 17 22 12"></polyline>
				</svg>
			)}
			{color === 'mathml' && (
				<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 19L10 5h10"></path>
					<path d="M4 5h16"></path>
					<circle cx="16" cy="14" r="3"></circle>
					<path d="M7 12h5"></path>
				</svg>
			)}
		</div>

		<div class="card-titles">
			<span class={`lang-badge ${colorClasses.badge}`} data-i18n={badgeKey}>{badge}</span>
			<h2 class="card-title">{title}</h2>
		</div>
	</div>

	<p class="description-text" data-i18n={descKey}>{description}</p>

	<div class="card-footer">
		<a 
			href={url} 
			target="_blank" 
			rel="noopener noreferrer" 
			class={`action-button ${colorClasses.btn}`}
		>
			<span data-i18n={btnKey}>{buttonLabel}</span>
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
				<line x1="5" y1="12" x2="19" y2="12"></line>
				<polyline points="12 5 19 12 12 19"></polyline>
			</svg>
		</a>
	</div>
</div>

<style>
	.dash-card {
		background: var(--bg-card);
		border-radius: 20px;
		border: 1px solid var(--border-card);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
	}

	.dash-card:hover {
		transform: translateY(-4px);
	}

	.card-xml:hover { border-color: rgba(249, 115, 22, 0.5); box-shadow: 0 12px 32px rgba(249, 115, 22, 0.15); }
	.card-md:hover { border-color: rgba(2, 132, 199, 0.5); box-shadow: 0 12px 32px rgba(2, 132, 199, 0.15); }
	.card-svg:hover { border-color: rgba(236, 72, 153, 0.5); box-shadow: 0 12px 32px rgba(236, 72, 153, 0.15); }
	.card-mathml:hover { border-color: rgba(139, 92, 246, 0.5); box-shadow: 0 12px 32px rgba(139, 92, 246, 0.15); }

	.card-top {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}

	.icon-wrapper {
		width: 52px;
		height: 52px;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		flex-shrink: 0;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
		transition: transform 0.3s ease;
	}

	.dash-card:hover .icon-wrapper {
		transform: scale(1.06) rotate(3deg);
	}

	.card-titles {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.lang-badge {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.15rem 0.5rem;
		border-radius: 6px;
		width: fit-content;
	}

	.badge-xml { background: rgba(249, 115, 22, 0.15); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.3); }
	.badge-md { background: rgba(2, 132, 199, 0.15); color: #38bdf8; border: 1px solid rgba(2, 132, 199, 0.3); }
	.badge-svg { background: rgba(236, 72, 153, 0.15); color: #f472b6; border: 1px solid rgba(236, 72, 153, 0.3); }
	.badge-mathml { background: rgba(139, 92, 246, 0.15); color: #a78bfa; border: 1px solid rgba(139, 92, 246, 0.3); }

	.card-title {
		font-family: 'Outfit', sans-serif;
		font-size: 1.4rem;
		font-weight: 800;
		color: var(--text-title);
		line-height: 1.2;
		transition: color 0.3s ease;
	}

	.description-text {
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.5;
		margin-bottom: 1.25rem;
		flex-grow: 1;
		transition: color 0.3s ease;
	}

	.card-footer {
		margin-top: auto;
	}

	.action-button {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		width: 100%;
		padding: 1rem 1.25rem;
		border-radius: 14px;
		font-family: 'Outfit', sans-serif;
		font-size: 1.15rem;
		font-weight: 800;
		text-decoration: none;
		color: #ffffff;
		transition: all 0.25s ease;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
	}

	.arrow-icon {
		transition: transform 0.25s ease;
	}

	.action-button:hover .arrow-icon {
		transform: translateX(4px);
	}

	.btn-xml {
		background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
		box-shadow: 0 6px 18px rgba(249, 115, 22, 0.35);
	}
	.btn-xml:hover {
		box-shadow: 0 8px 24px rgba(249, 115, 22, 0.55);
		transform: translateY(-2px);
	}

	.btn-md {
		background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
		box-shadow: 0 6px 18px rgba(2, 132, 199, 0.35);
	}
	.btn-md:hover {
		box-shadow: 0 8px 24px rgba(2, 132, 199, 0.55);
		transform: translateY(-2px);
	}

	.btn-svg {
		background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
		box-shadow: 0 6px 18px rgba(236, 72, 153, 0.35);
	}
	.btn-svg:hover {
		box-shadow: 0 8px 24px rgba(236, 72, 153, 0.55);
		transform: translateY(-2px);
	}

	.btn-mathml {
		background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
		box-shadow: 0 6px 18px rgba(139, 92, 246, 0.35);
	}
	.btn-mathml:hover {
		box-shadow: 0 8px 24px rgba(139, 92, 246, 0.55);
		transform: translateY(-2px);
	}
</style>
